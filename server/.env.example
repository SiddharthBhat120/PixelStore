PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pixelstore?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Local demo only: allows POST /api/auth/seed-admin to create the demo admin account.
# Leave this out (or set it to false) on any deployed server.
ALLOW_DEMO_SEED=true
